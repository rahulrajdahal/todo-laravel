                    {
                        "name": "id",
                        "in": "path",
                        "description": "Id of the todo to be updated.",
                        "required": true
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/Todo"
