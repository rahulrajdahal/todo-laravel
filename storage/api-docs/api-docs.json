                "tags": [
                    "Todos"
                ],
                "summary": "Get a list of todos",
                "operationId": "f270478a707b61a56293f8603545d504",
                "responses": {
                    "200": {
                        "description": "List of todos"
                    }
                }
            },
            "post": {
                "tags": [
                    "Todos"
                ],
                "summary": "AddTodo",
                "operationId": "8c2927a505c5934c6a3d4b7c92142456",
                "requestBody": {
                    "content": {
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/Todo"
                            }
                        },
                        "application/json": {
