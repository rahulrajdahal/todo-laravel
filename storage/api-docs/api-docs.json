                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Id of the todo to be updated.",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Returns the specified todo"
                    }
                }
            },
            "put": {
                "tags": [
                    "Todos"
                ],
                "summary": "UpdateTodo",
